# /etc/profile: system-wide .profile file for the Bourne shell
if [ "$(id -u)" -eq 0 ]; then
  PATH="/system/usr/local/sbin:/system/usr/local/bin:/system/usr/sbin:/system/usr/bin:/sbin:/bin"
else
  PATH="/system/usr/local/bin:/system/usr/bin:/bin:/system/usr/local/games:/system/usr/games"
fi
export PATH

if [ "${PS1-}" ]; then
  if [ "${BASH-}" ] && [ "$BASH" != "/bin/sh" ]; then
    # The file bash.bashrc already sets the default PS1.
    # PS1='\h:\w\$ '
    if [ -f /etc/bash.bashrc ]; then
      . /etc/bash.bashrc
    fi
  else
    if [ "$(id -u)" -eq 0 ]; then
      PS1='\u-trionyx:\w # '
    else
      PS1='trionyx:\w \$ '
    fi
  fi
fi
